{
  "manifest_version": 3,
  "name": "Gesture Cam",
  "version": "1.0.0",
  "description": "Hand gesture effects for your webcam in video calls: confetti, privacy blur, bang, fog mirror, Rasengan and a fake bad connection.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["page/fx.js", "page/camera.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["content/boot.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "vendor/*", "models/*"],
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"]
    }
  ]
}
